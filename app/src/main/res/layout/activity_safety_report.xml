<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRIVER SAFETY REPORT"
            android:textColor="@color/ink_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/report_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Today’s completed driving sessions"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAFETY SCORE"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/score_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/primary"
                    android:textSize="46sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/risk_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:id="@+id/stats_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TODAY’S DRIVING"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Drowsiness events" android:textColor="@color/ink_primary" android:textSize="16sp" />
                <TextView android:id="@+id/drowsiness_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/ink_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Yawns" android:textColor="@color/ink_primary" android:textSize="16sp" />
                <TextView android:id="@+id/yawns_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/ink_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Critical alerts" android:textColor="@color/ink_primary" android:textSize="16sp" />
                <TextView android:id="@+id/critical_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/ink_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Average alert time" android:textColor="@color/ink_primary" android:textSize="16sp" />
                <TextView android:id="@+id/average_alert_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/ink_primary" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Driving time" android:textColor="@color/ink_primary" android:textSize="16sp" />
                <TextView android:id="@+id/drive_duration_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/ink_primary" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
